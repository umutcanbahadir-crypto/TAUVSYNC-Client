{
  "$schema": "https://go.kicad.org/api/schemas/v1",
  "identifier": "com.github.umutcanbahadir-crypto.tauvsync",
  "name": "TAUV Team Projects",
  "description": "Open TAUV cloud projects and synchronize KiCad designs.",
  "runtime": {
    "type": "exec"
  },
