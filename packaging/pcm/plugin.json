      "show-button": true,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "TAUVSYNC.exe",
      "icons-light": [
        "tauv_transparent_24.png"
      ],
      "icons-dark": [
        "tauv_transparent_24.png"
      ]
    }
  ]
}
